{
  "name": "openchamber-tps",
  "version": "1.8.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OpenChamber extension panel that shows the rolling generation rate plus live token usage for the open session.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airtaxi/openchamber-tps.git"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.0"
    },
    "contributes": {
      "panel": {
        "id": "tps-meter",
        "name": "Token Meter",
        "icon": "speed-up-line",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Token Meter",
        "requiresProject": false,
        "defaultExpanded": true,
        "height": 92
      }
    }
  },
  "scripts": {
    "build": "bun run build:panel && bun run build:status && bun run build:service",
    "build:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
    "test": "node --test tests/*.test.ts",
    "build:status": "bunx openchamber-guest-bundle status/main.ts status/main.js"
  },
  "dependencies": {
    "@openchamber/sdk": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3"
  }
}
